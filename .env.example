# ==============================================================================
# Price-Scrapper Environment Configuration
# ==============================================================================
# Copy this file to .env or export these variables in your shell / execution environment.

# --- Anthropic AI (Claude) Configuration ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Web Scraping & Search APIs ---
SCRAPFLY_KEY=your_scrapfly_api_key_here
SERPAPI_KEY=your_serpapi_key_here
GEMINI_API_KEY=
DEFAULT_IMAGE_URL=

# --- AWS & DynamoDB Configuration ---
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_USERNAME=sc2

PRODUCT_TABLE=ProductsTable
SCRAPER_TRACKING_TABLE=ScraperRunTracker
FINAL_PRODUCT_TABLE=FinalProductsTable
ARCHIVE_PRODUCTS_TABLE=ArchiveProductsTable
FETCHERS_LOCK_TABLE=FetcherLocks
SCRAPER_STATS_TABLE=ScraperStats

# --- SMTP Email Notifications ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_TO=recipient_email@gmail.com
